{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "scripts/cursor-hooks/session-start.sh",
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "scripts/cursor-hooks/track-prompt.sh",
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "scripts/cursor-hooks/track-file-edit.sh",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "scripts/cursor-hooks/lint-before-git.sh",
        "matcher": "git\\s+(commit|push)",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "scripts/cursor-hooks/prompt-capture.sh",
        "failClosed": false
      }
    ]
  }
}
